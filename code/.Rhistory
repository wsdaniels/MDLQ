# b.vals <- seq(0, 6, by = 0.05)
b.vals <- c(0)
# c.vals <- seq(0, 3, by = 0.05)
c.vals <- c(0)
empirical.coverage <- array(NA, dim = c(length(a.vals), length(b.vals), length(c.vals), length(ci.name)))
for (a in 1:length(a.vals)){
print(paste0(a, "/", length(a.vals)))
for (b in 1:length(b.vals)){
for (c in 1:length(c.vals)){
new.var <- a.vals[a]^2 * post.var + b.vals[b]^2 * interval.level.sum + c.vals[c]^2
for (alpha in 1:length(alpha.seq)){
new.upper <- interval.level.sum + qnorm(1 - alpha.seq[alpha]/2) * sqrt(new.var)
new.lower <- interval.level.sum - qnorm(1 - alpha.seq[alpha]/2) * sqrt(new.var)
new.lower <- ifelse(new.lower < 0, 0, new.lower)
containment.mask <- interval.level.truth >= new.lower & interval.level.truth <= new.upper
empirical.coverage[a,b,c, alpha] <- sum(containment.mask, na.rm = T) / sum(!is.na(containment.mask))
}
}
}
}
