joined.chains <- vector(mode = "list", length = length(interval.level.truth))
for (i in 1:nrow(truth)){
if (length(mcmc.correct.dim[[i]]) > 1){
tmp1 <- as.matrix(mcmc.correct.dim[[i]][,to.use[i,]], nrow = 1500)
} else {
# joined.chains[[i]] <- rep(0, 1500)
tmp1 <- as.matrix(matrix(0, nrow = 1500, ncol = 5)[,to.use[i,]], nrow = 1500)
}
if (ncol(tmp1) > 0){
tmp2 <- apply(tmp1, 1, sum)
joined.chains[[i]] <- tmp2
} else {
joined.chains[[i]] <- NA
# print(i)
}
}
alpha.seq <- seq(5,95,5)/100
ci.name <- 1-alpha.seq
lower <- upper <- matrix(NA, nrow = length(joined.chains), ncol = length(alpha.seq))
post.var <- rep(NA, length(joined.chains))
for (i in 1:length(joined.chains)){
if (length(joined.chains[[i]]) > 1){
lower[i,] <- quantile(joined.chains[[i]], probs = alpha.seq/2)
upper[i,] <- quantile(joined.chains[[i]], probs = 1-alpha.seq/2)
post.var[i] <- var(joined.chains[[i]])
}
}
